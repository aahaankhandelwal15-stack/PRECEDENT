# Precedent V1 Configuration
# Copy this to .env and fill in your API keys

# API
API_TOKEN=dev-token-123
DATABASE_URL=sqlite:///./precedent.db

# LLM Provider (mock, nvidia, openai, anthropic)
LLM_PROVIDER=mock
LLM_MODEL=mock-model
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=30.0

# NVIDIA NIM Configuration
# Get your API key from https://build.nvidia.com/
NVIDIA_API_KEY=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
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-405b-instruct

# Embedding Provider
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-embedding
EMBEDDING_API_KEY=

# Retrieval
DEFAULT_TOP_K=5
MAX_TOP_K=20
SIMILARITY_THRESHOLD=0.3

# Confidence & Refusal
CONFIDENCE_THRESHOLD=0.5
MIN_EVIDENCE_SUFFICIENCY=0.3
MIN_RETRIEVAL_RELEVANCE=0.3

# Execution Budget
MAX_LLM_CALLS=10
MAX_TOKENS=50000
MAX_RETRIES=3
MAX_WALL_TIME_MS=30000
MAX_ESTIMATED_COST=10.0

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Logging_LEVEL=INFO